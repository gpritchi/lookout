// Renovate: version-bump PRs, run by the self-hosted Renovate in
// kubernetes_cluster (apps/renovate, weekdays 08:00). Nothing automerges.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "America/Vancouver",
  // One run a day, so an hourly cap would mean a couple of PRs a day.
  prHourlyLimit: 0,

  // Broad minimum requirements otherwise leave transitive pins stale.
  lockFileMaintenance: { enabled: true, schedule: ["* * * * 1-5"] },

  packageRules: [
    {
      // pyproject.toml / uv.lock: one PR for every non-major bump.
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python dependencies (non-major)",
    },
    {
      matchPackageNames: ["ghcr.io/astral-sh/uv", "astral-sh/uv"],
      groupName: "uv tooling",
    },
    {
      // All Docker stages inherit one Python base; CI reads .python-version.
      matchManagers: ["dockerfile", "pyenv"],
      matchPackageNames: ["python"],
      groupName: "Python runtime",
      // Remove only after OpenVINO and CPU torch/torchvision publish wheels
      // and the complete image/export/smoke checks pass on the next minor.
      allowedVersions: "/^3\\.14(?:\\.|-|$)/",
      prBodyNotes: ["Python is held on 3.14 because OpenVINO and CPU torch/torchvision lack 3.15 wheels. All stages share the Docker base; keep .python-version aligned."],
    },
  ],
}
