# Private working notes (AI-usage journal, planning scratch, LAN specifics) — not part
# of the submission. Anything worth publishing is rewritten into sanitized-notes/,
# which IS committed.
notes/
unsanitized-notes/

# Personal camera footage never gets committed. Sanitized/synthetic samples go in
# fixtures/sample/ instead.
fixtures/private/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Exported model weights (re-generated by `yolo export`, large)
*_openvino_model/
*.pt
*.onnx

# Secrets / local env
.env
# Deployment-specific configs (real camera URLs, real proxy) stay local; the
# committed example is the template.
config/*.local.json

# OS noise
.DS_Store
