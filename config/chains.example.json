{
  "models": {
    "qwen3-vl": {
      "type": "openai-compatible",
      "endpoint": "http://localhost:4000/v1",
      "model": "qwen3-vl-8b-instruct",
      "capabilities": ["image", "image_sequence"]
    },
    "nemotron-omni": {
      "type": "openai-compatible",
      "endpoint": "http://localhost:8080/v1",
      "model": "nemotron-omni",
      "capabilities": ["image", "image_sequence", "video_clip"]
    }
  },

  "cameras": {
    "driveway": {
      "source": "rtsp://localhost:8554/driveway",
      "clips": { "playback": "http://localhost:9996", "path": "driveway" }
    },
    "living-room": { "source": "fixtures/private/living-room.mp4", "tier1": "mediapipe-hands" }
  },

  "tier1": {
    "model": "yolov8n",
    "backend": "openvino",
    "min_confidence": 0.5,
    "count_confidence": 0.3,
    "min_box_frac": 0.004,
    "debounce_frames": 3,
    "analysis_fps": 4,
    "frame_fps": 2
  },

  "actions": {
    "sink": "mock",
    "ha_webhook_url": null
  },

  "metrics": { "port": 9108 },

  "chains": [
    {
      "id": "driveway-arrivals",
      "camera": "driveway",
      "trigger": { "label": ["car", "truck"], "priority": 10 },
      "window": { "before_s": 2, "after_s": 8, "frames": 6 },
      "steps": [
        {
          "id": "classify-vehicle",
          "model": "qwen3-vl",
          "payload": "image",
          "priority": 50,
          "timeout_s": 30,
          "prompt": "Look at the vehicle in this driveway image. Identify it by make/body style and color. Answer with exactly one of: GREY_VAN, BLACK_TACOMA, OTHER.",
          "outcomes": {
            "GREY_VAN": { "next": "check-driver" },
            "BLACK_TACOMA": { "next": "check-tacoma-driver" },
            "OTHER": { "end": true }
          }
        },
        {
          "id": "check-driver",
          "model": "qwen3-vl",
          "payload": "image_sequence",
          "priority": 60,
          "timeout_s": 60,
          "prompt": "These frames follow a grey van parking in the driveway. Does a person in a reflective vest get out, take a package from the van, and head toward the house? Answer exactly one of: DELIVERY_IN_PROGRESS, PERSON_NO_PACKAGE, NOBODY_YET.",
          "outcomes": {
            "DELIVERY_IN_PROGRESS": { "next": "confirm-delivery" },
            "PERSON_NO_PACKAGE": { "action": { "type": "notify", "message": "Unknown grey van in driveway" } },
            "NOBODY_YET": { "retry_in_s": 5 }
          }
        },
        {
          "id": "confirm-delivery",
          "model": "nemotron-omni",
          "payload": "video_clip",
          "priority": 40,
          "timeout_s": 300,
          "window": { "before_s": 5, "after_s": 30 },
          "prompt": "This clip shows a delivery driver at the front of a house. Watch the whole clip. Did the driver bring a package TO the house and leave it there, or take a package AWAY from the house, or neither? Picking a package out of the delivery van counts as bringing it. Answer exactly one of: DELIVERED, TAKEN, NEITHER.",
          "outcomes": {
            "DELIVERED": { "action": { "type": "notify", "message": "Package delivered" } },
            "TAKEN": { "action": { "type": "notify", "message": "A package was taken from the porch" } },
            "NEITHER": { "action": { "type": "notify", "message": "Delivery driver visited, no package seen" } }
          }
        },
        {
          "id": "check-tacoma-driver",
          "model": "qwen3-vl",
          "payload": "image_sequence",
          "priority": 60,
          "timeout_s": 60,
          "window": { "before_s": 2, "after_s": 20, "frames": 8 },
          "prompt": "These frames follow a black Tacoma parking. Watch who exits and from which door. Does a man exit from the driver's side, or a woman, or has nobody exited yet? Answer exactly one of: MAN_DRIVER_SIDE, WOMAN, NOBODY_YET.",
          "outcomes": {
            "MAN_DRIVER_SIDE": { "next": "count-visitors" },
            "WOMAN": { "action": { "type": "notify", "message": "Sister-in-law is stopping by" } },
            "NOBODY_YET": { "retry_in_s": 5 }
          }
        },
        {
          "id": "count-visitors",
          "model": "nemotron-omni",
          "payload": "video_clip",
          "priority": 40,
          "timeout_s": 300,
          "window": { "before_s": 5, "after_s": 40 },
          "prompt": "This clip shows a black pickup truck that has just parked in a driveway. Watch the whole clip. How many people get out of the truck, and do they walk toward the house? Answer exactly one of: ONE_TO_HOUSE, TWO_TO_HOUSE, NOBODY_LEFT_TRUCK.",
          "outcomes": {
            "ONE_TO_HOUSE": { "action": { "type": "notify", "message": "Brother is at the door" } },
            "TWO_TO_HOUSE": { "action": { "type": "notify", "message": "Brother and sister-in-law are at the door" } },
            "NOBODY_LEFT_TRUCK": { "retry_in_s": 10 }
          }
        }
      ]
    },
    {
      "id": "tv-netflix",
      "camera": "living-room",
      "comment": "Deliberately NO escalation steps: finger-count gestures are cheap-model territory (MediaPipe hand landmarks on CPU), so the action fires one-shot at tier-1. held_frames is the intent filter — a signal held toward the camera, not a passing hand position. Demonstrates that the tier boundary is empirical: conditions live at the cheapest tier that can handle them.",
      "trigger": { "label": "gesture:three_fingers", "held_frames": 8, "priority": 100 },
      "steps": [],
      "on_trigger": { "action": { "type": "ha_webhook", "service": "tv_netflix_on" } }
    },
    {
      "id": "tv-plex",
      "camera": "living-room",
      "trigger": { "label": "gesture:four_fingers", "held_frames": 8, "priority": 100 },
      "steps": [],
      "on_trigger": { "action": { "type": "ha_webhook", "service": "tv_plex_on" } }
    },
    {
      "id": "tv-off",
      "camera": "living-room",
      "trigger": { "label": "gesture:ok_sign", "held_frames": 8, "priority": 100 },
      "steps": [],
      "on_trigger": { "action": { "type": "ha_webhook", "service": "tv_off" } }
    }
  ]
}
